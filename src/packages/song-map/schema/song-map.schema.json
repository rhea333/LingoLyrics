{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rhea333/LingoLyrics/src/packages/song-map/schema/song-map.schema.json",
  "title": "LingoLyrics song map",
  "description": "Timed lyric lines for one song, shared by the learner app and the song-map editor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "artist", "language", "audio", "rights", "lines"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "description": "Semantic version of this schema. Readers accept any 1.x.y.",
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "id": {
      "description": "Stable song id, lowercase kebab-case.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "artist": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "description": "BCP 47 language tag of the lyrics, e.g. ja.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "durationMs"],
      "properties": {
        "file": {
          "description": "Audio file path, relative to the song map file.",
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rights": {
      "description": "Where the lyrics and audio come from and under what license.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lyrics", "audio"],
      "properties": {
        "lyrics": {
          "$ref": "#/$defs/rightsEntry"
        },
        "audio": {
          "$ref": "#/$defs/rightsEntry"
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/line"
      }
    }
  },
  "$defs": {
    "rightsEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "source"],
      "properties": {
        "license": {
          "description": "Allowed licenses only, so unlicensed or all-rights-reserved content fails validation. PLACEHOLDER marks content still pending. Add an SPDX id here only after the team checks it allows redistribution in this MIT repo.",
          "enum": ["MIT", "CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0", "PUBLIC-DOMAIN", "PLACEHOLDER"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startMs", "endMs", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "translation": {
          "type": "string"
        },
        "words": {
          "description": "Optional pre-computed segmentation (the R2 fallback: computed in the editor and checked by the creator).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/word"
          }
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "surface"],
      "properties": {
        "start": {
          "description": "UTF-16 offset into the line text, inclusive.",
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "description": "UTF-16 offset into the line text, exclusive.",
          "type": "integer",
          "minimum": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "reading": {
          "type": "string"
        },
        "romaji": {
          "type": "string"
        },
        "gloss": {
          "type": "string"
        }
      }
    }
  }
}
