{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node", "jest"],
    "paths": {
      "@lingolyrics/*": ["packages/*/src"],
      "react-native": ["node_modules/react-native/types_generated/index.d.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "scripts/**/*", "../test/**/*"],
  "exclude": ["node_modules", "apps"]
}
